    "deny": [
      "PowerShell(git push*--force*)",
      "PowerShell(git push* -f)",
      "PowerShell(git push* -f *)",
      "PowerShell(git -C * push*--force*)",
      "PowerShell(git -C * push* -f)",
      "PowerShell(git -C * push* -f *)",
      "PowerShell(git *--no-verify*)",
      "PowerShell(git commit*--amend*)",
      "PowerShell(git -C * commit*--amend*)",
      "PowerShell(git reset*--hard*)",
      "PowerShell(git -C * reset*--hard*)",
      "PowerShell(git rebase*)",
      "PowerShell(git -C * rebase*)",
      "PowerShell(git add* -f)",
      "PowerShell(git add* -f *)",
      "PowerShell(git add*--force*)",
      "PowerShell(git -C * add* -f)",
      "PowerShell(git -C * add* -f *)",
      "PowerShell(git -C * add*--force*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f)",
      "Bash(git push* -f *)",
      "Bash(git -C * push*--force*)",
      "Bash(git -C * push* -f)",
      "Bash(git -C * push* -f *)",
      "Bash(git *--no-verify*)",
      "Bash(git commit*--amend*)",
      "Bash(git -C * commit*--amend*)",
      "Bash(git reset*--hard*)",
      "Bash(git -C * reset*--hard*)",
      "Bash(git rebase*)",
      "Bash(git -C * rebase*)",
      "Bash(git add* -f)",
      "Bash(git add* -f *)",
      "Bash(git add*--force*)",
      "Bash(git -C * add* -f)",
      "Bash(git -C * add* -f *)",
      "Bash(git -C * add*--force*)"
    ]
  },
  "enabledPlugins": {
    "obsidian@obsidian-skills": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  }
}
