{
  "skillOverrides": {
    "docs": "off",
    "computer-use": "off",
    "build-in-browser": "off",
    "chrome-browser": "off"
  },
  "permissions": {
    "allow": [
      "PowerShell(git show *)",
      "PowerShell(git remote -v)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git check-ignore *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git ls-files *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Resolve-Path *)",
      "PowerShell(Select-String *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Sort-Object *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Format-Table *)",
      "PowerShell(Format-List *)",
      "PowerShell(Out-String *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git branch --show-current)",
      "Bash(git check-ignore *)",
      "Bash(git rev-parse *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Read(~/shared/**)"
    ],
    "deny": [
      "PowerShell(git push*--force*)",
      "PowerShell(git push* -f)",
      "PowerShell(git push* -f *)",
      "PowerShell(git rebase* -i*)",
      "PowerShell(git rebase* --interactive*)",
      "PowerShell(git rebase* --exec*)",
      "PowerShell(git rebase* -x*)",
      "PowerShell(git rebase* --root*)",
      "PowerShell(git -C * push*--force*)",
      "PowerShell(git -C * push* -f)",
      "PowerShell(git -C * push* -f *)",
      "PowerShell(git -C * rebase* -i*)",
      "PowerShell(git -C * rebase* --interactive*)",
      "PowerShell(git -C * rebase* --exec*)",
      "PowerShell(git -C * rebase* -x*)",
      "PowerShell(git -C * rebase* --root*)",
      "PowerShell(git *--no-verify*)",
      "PowerShell(git commit*--amend*)",
      "PowerShell(git -C * commit*--amend*)",
      "PowerShell(git reset*--hard*)",
      "PowerShell(git -C * reset*--hard*)",
      "PowerShell(git add* -f)",
      "PowerShell(git add* -f *)",
      "PowerShell(git add*--force*)",
      "PowerShell(git -C * add* -f)",
      "PowerShell(git -C * add* -f *)",
      "PowerShell(git -C * add*--force*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f)",
      "Bash(git push* -f *)",
      "Bash(git rebase* -i*)",
      "Bash(git rebase* --interactive*)",
      "Bash(git rebase* --exec*)",
      "Bash(git rebase* -x*)",
      "Bash(git rebase* --root*)",
      "Bash(git -C * push*--force*)",
      "Bash(git -C * push* -f)",
      "Bash(git -C * push* -f *)",
      "Bash(git -C * rebase* -i*)",
      "Bash(git -C * rebase* --interactive*)",
      "Bash(git -C * rebase* --exec*)",
      "Bash(git -C * rebase* -x*)",
      "Bash(git -C * rebase* --root*)",
      "Bash(git *--no-verify*)",
      "Bash(git commit*--amend*)",
      "Bash(git -C * commit*--amend*)",
      "Bash(git reset*--hard*)",
      "Bash(git -C * reset*--hard*)",
      "Bash(git add* -f)",
      "Bash(git add* -f *)",
      "Bash(git add*--force*)",
      "Bash(git -C * add* -f)",
      "Bash(git -C * add* -f *)",
      "Bash(git -C * add*--force*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$h = \"$HOME/works/resources/workflow-kit/tools/session_resume_inject.py\"; if (Test-Path $h) { python -I $h }",
            "shell": "powershell"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/stop-record.py\"",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$h = \"$HOME/works/resources/workflow-kit/tools/context_probe_hook.py\"; if (Test-Path $h) { python -I $h }",
            "shell": "powershell"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$h = \"$HOME/works/resources/workflow-kit/tools/triggers_hook.py\"; if (Test-Path $h) { python -I $h }",
            "shell": "powershell"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "theme": "dark-ansi",
  "statusLine": {
    "type": "command",
    "command": "python -I ~/.claude/statusline.py"
  }
}
