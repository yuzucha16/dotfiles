// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "font_family": "PlemolJP Console NF",
    "font_weight": 300,
    "font_fallbacks": ["Moralerspace Neon HW", "Meiryo UI"]
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "sonnet"
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "html": true,
    "powershell": true,
    "windows-batch": true
  },
  
  "vim_mode": true,

  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },

  "ui_font_family": "PlemolJP Console NF",
  "ui_font_weight": 300,
  "ui_font_fallbacks": ["Moralerspace Neon HW", "Meiryo UI"],
  "ui_font_size": 15,
  "buffer_font_size": 15,
  "agent_ui_font_size": 15,
  "agent_buffer_font_size": 15,
  "buffer_font_family": "PlemolJP Console NF",
  "buffer_font_weight": 300,
  "buffer_font_fallbacks": ["Moralerspace Neon HW", "Meiryo UI"],

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark"
  },

  "gutter": {
    "line_numbers": true
  },

  "auto_indent": true,
  "hard_tabs": false,
  "tab_size": 4,

  "use_smartcase_search": true,

  "vim": {
    "use_system_clipboard": "always"
  },

  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": true,
    "active_encoding_button": "enabled"
  }
}